<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!--
    MeowCat MSI — per-machine install with full upgrade & uninstall support.
    - MajorUpgrade: installing a newer (or same) version cleanly removes the old one;
      uninstall available via Settings > Apps or `msiexec /x {ProductCode}`.
    - UpgradeCode is STABLE across versions — never change it.
  -->
  <Package Name="MeowCat"
           Manufacturer="mythos0"
           Version="$(var.Version)"
           UpgradeCode="B7E4A2D1-8C93-4F6E-9A15-D20C7E3F8B42"
           Scope="perMachine"
           Compressed="true"
           Language="1033"
           Codepage="1252">

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed. Uninstall it first." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.exe" SourceFile="$(var.PublishDir)/Assets/app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.exe" />
    <Property Id="ARPHELPLINK" Value="https://github.com/mythos0/meow" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <Feature Id="Main" Title="MeowCat" Description="The realistic desktop cat" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <?include Dirs.wxi ?>

    <ComponentGroup Id="AppFiles">
      <?include Files.wxi ?>
    </ComponentGroup>

    <Component Id="StartMenuShortcut" Directory="AppMenuDir">
      <Shortcut Id="MeowCatShortcut"
                Name="MeowCat"
                Description="Your realistic 3D-shaded desktop cat"
                Target="[INSTALLFOLDER]MeowCat.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon.exe" />
      <RemoveFolder Id="RemoveAppMenuDir" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\MeowCat" Name="installed"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Desktop shortcut is created BY DEFAULT on install (per-machine →
         Public Desktop so every user sees it); removed on uninstall. -->
    <Component Id="DesktopShortcut" Directory="DesktopFolder">
      <Shortcut Id="MeowCatDesktopShortcut"
                Name="MeowCat"
                Description="Your realistic 3D-shaded desktop cat"
                Target="[INSTALLFOLDER]MeowCat.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon.exe" />
      <RegistryValue Root="HKCU" Key="Software\MeowCat" Name="desktopShortcut"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

  </Package>
</Wix>
