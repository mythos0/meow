name: Build MSI

on:
  push:
    branches: [main]
    paths:
      - "installer/**"
      - "src/**"
      - "scripts/**"
      - ".github/workflows/build-msi.yml"
  workflow_dispatch:

permissions:
  contents: write

jobs:
  msi:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-dotnet@v4
        with:
          dotnet-version: 8.0.x

      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Run unit tests
        run: dotnet test MeowCat.sln -c Release

      - name: Publish app (win-x64)
        run: dotnet publish src/MeowCat/MeowCat.csproj -c Release -r win-x64 --self-contained false -p:Version=1.0.0 -o artifacts/publish

      - name: Harvest files for WiX
        run: python scripts/gen_wix_files.py artifacts/publish installer/Files.wxi

      - name: Install WiX v5
        run: dotnet tool install --global wix --version 5.0.2

      - name: Build MSI
        shell: pwsh
        run: |
          $env:PATH = "$env:USERPROFILE\.dotnet\tools;$env:PATH"
          $pub = (Join-Path $PWD "artifacts\publish")
          wix build installer/Product.wxs -d "PublishDir=$pub" -d "Version=1.0.0" -arch x64 -o "artifacts\MeowCat-1.0.0-x64.msi"

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: MeowCat-1.0.0-x64-msi
          path: artifacts/MeowCat-1.0.0-x64.msi
          if-no-files-found: error

      - name: Create/Update Release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: v1.0.0
          name: MeowCat v1.0.0
          files: artifacts/MeowCat-1.0.0-x64.msi
          overwrite_files: true
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
