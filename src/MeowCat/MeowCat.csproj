<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MeowCat</RootNamespace>
    <AssemblyName>MeowCat</AssemblyName>
    <Version>4.0.0</Version>
    <FileVersion>4.0.0.0</FileVersion>
    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <Product>MeowCat</Product>
    <Description>A procedurally animated desktop cat for Windows 11 — one process, tiny memory</Description>
    <Company>mythos0</Company>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\sounds\*.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MeowCat.Core\MeowCat.Core.csproj" />
  </ItemGroup>

  <!-- WPF wins all ambiguity battles against WinForms -->
  <ItemGroup>
    <Using Alias="Point" Include="System.Windows.Point" />
    <Using Alias="Brush" Include="System.Windows.Media.Brush" />
    <Using Alias="Pen" Include="System.Windows.Media.Pen" />
    <Using Alias="Button" Include="System.Windows.Controls.Button" />
    <Using Alias="TabControl" Include="System.Windows.Controls.TabControl" />
    <Using Alias="Application" Include="System.Windows.Application" />
    <Using Alias="MouseEventArgs" Include="System.Windows.Input.MouseEventArgs" />
    <Using Alias="Brushes" Include="System.Windows.Media.Brushes" />
    <Using Alias="Color" Include="System.Windows.Media.Color" />
    <Using Alias="ColorConverter" Include="System.Windows.Media.ColorConverter" />
    <Using Alias="Orientation" Include="System.Windows.Controls.Orientation" />
    <Using Alias="FlowDirection" Include="System.Windows.FlowDirection" />
    <Using Alias="FontFamily" Include="System.Windows.Media.FontFamily" />
    <Using Alias="Size" Include="System.Windows.Size" />
    <Using Alias="ListBox" Include="System.Windows.Controls.ListBox" />
    <Using Alias="TextBox" Include="System.Windows.Controls.TextBox" />
    <Using Alias="ComboBox" Include="System.Windows.Controls.ComboBox" />
    <Using Alias="CheckBox" Include="System.Windows.Controls.CheckBox" />
    <Using Alias="Slider" Include="System.Windows.Controls.Slider" />
  </ItemGroup>

</Project>
